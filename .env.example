# ---- Vector store (Qdrant) ----
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_DENSE=aerospace_dense

# ---- Graph ----
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please_change_me

# ---- LangGraph checkpointer ----
POSTGRES_PASSWORD=please_change_me
POSTGRES_DSN=postgresql://langgraph:please_change_me@postgres:5432/langgraph

# ---- Local LLM ----
OLLAMA_HOST=http://ollama:11434
# Generation model. Keep it small enough to share the 8 GB GPU with the
# retrieval models + the backend's CUDA context: a ~6.9 GB model (e.g.
# qwen3-vl:8b) crashes the WSL GPU VM at the generate step. qwen3:4b (~2.5 GB,
# multilingual EN/FR/ZH) leaves comfortable headroom. Image understanding is
# handled at INGESTION (Qwen2.5-VL captions figures → text chunks), so a text
# LLM here loses nothing. On a bigger GPU, qwen3:8b is fine.
OLLAMA_MODEL=qwen3:4b
# Qwen3 reasoning ("thinking") is OFF by default (we append /no_think): faster
# and better at the strict [doc_id p.page] citation format. OLLAMA_THINK=1 re-enables.
OLLAMA_THINK=0

# ---- Models (downloaded on first run via HuggingFace on local machine) ----
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
CLIP_MODEL=openai/clip-vit-base-patch32

# Device for the backend's query-time BGE-M3 + reranker. Unset = GPU (auto).
# With a small LLM (qwen3:4b), retrieval (~2.2 GB) + LLM (~2.5 GB) co-reside on
# the 8 GB GPU comfortably — fast, no swapping. Set RETRIEVE_DEVICE=cpu only if
# you must run a large LLM that needs the whole card (then also set
# SEQUENTIAL_VRAM_UNLOAD=1 below). Forcing cpu makes the rerank slow here.
# RETRIEVE_DEVICE=

# Sequential-VRAM unload: free retrieval models (BGE-M3 + reranker, ~4.4 GB
# fp16) before each generation, with a mem barrier. ON by default — on an 8 GB
# card the LLM needs that room for its weights + KV cache (else Ollama offloads
# to CPU and crawls). Set to 0 only on a GPU big enough to hold both at once.
SEQUENTIAL_VRAM_UNLOAD=1

# Ollama VRAM hold time. "0" = unload the LLM right after each answer. Fine with
# a small co-resident LLM; raise (e.g. "5m") to keep it warm for faster repeats.
OLLAMA_KEEP_ALIVE=0

# ---- Tracing ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=graphrag-aero

# ---- App ----
BACKEND_PORT=8080
NEXT_PUBLIC_API_BASE=http://localhost:8080
